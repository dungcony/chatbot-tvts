# Ollama
# Model local (chay tren may): gemma2:2b, qwen2.5:7b, ...
# Model cloud (goi API Ollama): gpt-oss:120b-cloud, gpt-oss:20b-cloud, ...
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Ollama Cloud (chi can neu dung model cloud)
# Tao API key tai: https://ollama.com/settings/keys
OLLAMA_API_KEY=

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>
DB_NAME=tuvantuyensinh
